rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /currencies/{currencyId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /rateHistory/{historyId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'createdAt', 'lastLogin', 'favorites'
        ])
        && request.resource.data.favorites is list
        && request.resource.data.favorites.size() <= 100;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'lastLogin', 'favorites'
        ])
        && request.resource.data.favorites is list
        && request.resource.data.favorites.size() <= 100;
      allow delete: if false;

      match /conversion_history/{entryId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['from', 'to', 'amount', 'result', 'createdAt'])
          && request.resource.data.from is string
          && request.resource.data.to is string
          && request.resource.data.from.size() <= 12
          && request.resource.data.to.size() <= 12
          && request.resource.data.amount is number
          && request.resource.data.result is number
          && request.resource.data.amount >= 0
          && request.resource.data.result >= 0;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /alerts/{alertId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['currencyId', 'targetPrice', 'direction', 'active', 'createdAt'])
          && request.resource.data.currencyId is string
          && request.resource.data.targetPrice is number
          && request.resource.data.targetPrice >= 0
          && request.resource.data.direction in ['above', 'below']
          && request.resource.data.active is bool;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /admins/{adminId} {
      allow get: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /ads_impressions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ads_requests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ads_failures/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
